---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostCard from '../../../components/PostCard.astro';
import { LANGS, ui, langParam, type Lang } from '../../../i18n/ui';
import { getPosts } from '../../../utils/posts';

export function getStaticPaths() {
  return LANGS.map((l) => ({ params: { lang: langParam(l) }, props: { lang: l } }));
}
const { lang } = Astro.props as { lang: Lang };
const t = ui[lang];
const posts = await getPosts(lang);
---

<BaseLayout lang={lang} title={t.allPosts}>
  <h1>{t.allPosts}</h1>
  {posts.length === 0 ? <p class="empty">{t.noPosts}</p> : posts.map((p) => <PostCard post={p} lang={lang} />)}
</BaseLayout>
