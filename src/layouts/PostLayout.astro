---
import BaseLayout from './BaseLayout.astro';
import { ui, tagLabels, url, type Lang } from '../i18n/ui';
import type { Post } from '../utils/posts';
interface Props { post: Post; lang: Lang; altHref: string }
const { post, lang, altHref } = Astro.props;
const t = ui[lang];
const { title, date, summary, tags, draft } = post.data;
---

<BaseLayout lang={lang} title={title} description={summary} altHref={altHref} type="article">
  <article class="post">
    <p><a class="back" href={url(lang, 'blog')}>{t.backToBlog}</a></p>
    <h1>{title}{draft && <span class="draft">DRAFT</span>}</h1>
    <div class="meta">
      <time datetime={date.toISOString()}>
        {date.toLocaleDateString(t.locale, { dateStyle: 'long', timeZone: 'UTC' })}
      </time>
      {tags.map((tag) => <a class="tag" href={url(lang, `tags/${tag}`)}>{tagLabels[lang][tag]}</a>)}
    </div>
    <div class="prose"><slot /></div>
  </article>
</BaseLayout>

<style>
  .post h1 { margin-bottom: 0.5rem; }
  .back { color: var(--muted); text-decoration: none; font-size: 0.95rem; }
  .back:hover { color: var(--accent); }
  .draft { margin-left: 0.75rem; font-size: 0.8rem; padding: 0.1rem 0.5rem; border-radius: 4px; background: #f59e0b; color: #000; vertical-align: middle; }
  .prose { margin-top: 1.5rem; }
</style>
