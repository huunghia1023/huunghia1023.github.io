---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { ui, url, otherLang, type Lang } from '../i18n/ui';
import { SITE_URL } from '../config';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  /** URL of the same page in the other language. Defaults to swapping the /vi prefix. */
  altHref?: string;
  type?: 'website' | 'article';
}
const { lang, title, description, type = 'website' } = Astro.props;
const t = ui[lang];
const path = Astro.url.pathname;
const swapped = lang === 'en' ? '/vi' + path : path.replace(/^\/vi(?=\/|$)/, '') || '/';
const altHref = Astro.props.altHref ?? swapped;
const fullTitle = title ? `${title} | ${t.siteTitle}` : t.siteTitle;
const desc = description ?? t.siteDescription;
const canonical = new URL(path, Astro.site ?? SITE_URL);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={t.siteTitle} href={url(lang, 'rss.xml').replace(/\/$/, '')} />
    <link rel="alternate" hreflang={otherLang(lang)} href={new URL(altHref, Astro.site ?? SITE_URL)} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta name="theme-color" content="#2563eb" />
    <!-- Set the theme before the page paints, to avoid a flash -->
    <script is:inline>
      (function () {
        var saved = null;
        try { saved = localStorage.getItem('theme'); } catch (e) {}
        var dark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.dataset.theme = saved || (dark ? 'dark' : 'light');
      })();
    </script>
  </head>
  <body>
    <Header lang={lang} altHref={altHref} />
    <main class="wrap"><slot /></main>
    <Footer lang={lang} />
  </body>
</html>
